# Production deployment template. Copy to .env.production and never commit the populated file.
# Replace every placeholder with a deployment-specific secret from a protected secret store.
COMPOSE_PROJECT_NAME=puffinpal-production
CADDY_SITE_ADDRESS=billing.example.com
CADDY_HSTS=max-age=31536000; includeSubDomains
WEB_ORIGIN=https://billing.example.com
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1

POSTGRES_USER=puffinpal
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=puffinpal
DATABASE_URL=postgresql://puffinpal:replace-with-a-long-random-password@postgres:5432/puffinpal

REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379/0
REDIS_RATE_LIMIT_PREFIX=puffinpal:auth-rate-limit
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_RECONNECT_MAX_RETRIES=3
BULLMQ_REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379/0
BULLMQ_PREFIX=puffinpal:jobs
BULLMQ_CONNECT_TIMEOUT_MS=5000
BULLMQ_RECONNECT_MAX_RETRIES=5
PAYROLL_WORKER_CONCURRENCY=2
INVOICE_EXPORT_WORKER_CONCURRENCY=2
RECURRING_INVOICE_WORKER_CONCURRENCY=2

S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=puffinpal-private
S3_ACCESS_KEY_ID=replace-with-random-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret

JWT_SECRET=replace-with-at-least-32-random-bytes
INVOICE_EXPORT_RETENTION_HOURS=24

# Public production deployments require HTTPS and COOKIE_SECURE=true.
# For local production-like HTTP testing only, use http://localhost, max-age=0,
# WEB_ORIGIN=http://localhost, and COOKIE_SECURE=false.
