      {
        "description": "create table \"expense_approval_history\"",
        "sql": "CREATE TABLE \"public\".\"expense_approval_history\" (\n  \"action\" text NOT NULL,\n  \"actorId\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"expenseId\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"newStatus\" text NOT NULL,\n  \"organizationId\" text NOT NULL,\n  \"previousStatus\" text NOT NULL,\n  \"rejectionReason\" text,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"expense_approval_history_action_check_8586241b\" CHECK (\"action\" IN ('SUBMITTED', 'APPROVED', 'REJECTED', 'REOPENED', 'RESUBMITTED')),\n  CONSTRAINT \"expense_approval_history_newStatus_check_b818a279\" CHECK (\"newStatus\" IN ('DRAFT', 'PENDING_APPROVAL', 'APPROVED', 'REJECTED')),\n  CONSTRAINT \"expense_approval_history_previousStatus_check_23699b52\" CHECK (\"previousStatus\" IN ('DRAFT', 'PENDING_APPROVAL', 'APPROVED', 'REJECTED'))\n)",
        "params": []
      }
    ],
    "postcheck": [
