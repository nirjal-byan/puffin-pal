        "sql": "CREATE TABLE \"public\".\"invoice_exports\" (\n  \"archiveKey\" text,\n  \"archiveName\" text,\n  \"archiveSize\" int4,\n  \"completedAt\" timestamptz,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"expiresAt\" timestamptz NOT NULL,\n  \"failureCode\" text,\n  \"id\" text NOT NULL,\n  \"invoiceIds\" text NOT NULL,\n  \"organizationId\" text NOT NULL,\n  \"progress\" int4 DEFAULT 0 NOT NULL,\n  \"requestFingerprint\" text NOT NULL,\n  \"requestId\" text NOT NULL,\n  \"requestedByUserId\" text NOT NULL,\n  \"status\" text DEFAULT 'QUEUED' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"invoice_exports_status_check_81add6e9\" CHECK (\"status\" IN ('QUEUED', 'PROCESSING', 'COMPLETED', 'FAILED', 'EXPIRED'))\n)",
        "params": []
      }
