// use prisma-8
enum Role {
  OWNER
  ADMIN
  PROJECT_MANAGER
  FINANCE_VIEWER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum OnboardingStatus {
  LEGACY
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  CHEQUE
  OTHER
}

enum ExpenseCategory {
  SOFTWARE
  HARDWARE
  TRAVEL
  MARKETING
  OTHER
}

enum ExpenseApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum ExpenseApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  REOPENED
  RESUBMITTED
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecurringOccurrenceStatus {
  PENDING
  PROCESSING
  GENERATED
  FAILED
}

enum RecurringScheduleAction {
  CREATED
  UPDATED
  PAUSED
  RESUMED
  CANCELLED
  OCCURRENCE_GENERATED
  AUTO_ISSUED
  GENERATION_FAILED
  RETRIED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

enum CompensationType {
  FIXED_SALARY
  HOURLY
}

enum PayFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum EmployeeAuditAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  TERMINATED
  SALARY_CREATED
  SALARY_REVISED
  SALARY_SCHEDULED
}

enum PayrollRunStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  FINALIZED
}

enum PayrollComponentType {
  EARNING
  DEDUCTION
}

enum PayslipStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayrollAuditAction {
  CREATED
  CALCULATED
  ADJUSTED
  SUBMITTED
  APPROVED
  REJECTED
  FINALIZED
  PAYSLIP_GENERATED
  PAYSLIP_FAILED
  PAYMENT_RECORDED
}

model Organization {
  id                      String                       @id @default(uuid())
  name                    String
  slug                    String                       @unique
  website                 String?
  employeeCount           String?
  logoUrl                 String?
  currency                String                       @default("USD")
  createdAt               DateTime                     @default(now())
  updatedAt               temporal.updatedAt()

  users                   User[]
  memberships             Membership[]
  clients                 Client[]
  invoices                Invoice[]
  invoiceExports          InvoiceExport[]
  payments                Payment[]
  expenses                Expense[]
  expenseApprovalHistory  ExpenseApprovalHistory[]
  retainers               Retainer[]
  recurringSchedules      RecurringInvoiceSchedule[]
  recurringOccurrences    RecurringInvoiceOccurrence[]
  recurringScheduleEvents RecurringScheduleEvent[]
  departments             Department[]
  employees               Employee[]
  salaryStructures        SalaryStructure[]
  employeeAuditEvents     EmployeeAuditEvent[]
  payrollRuns             PayrollRun[]
  payrollEntries          PayrollEntry[]
  payrollPayments         PayrollPayment[]
  payrollAuditEvents      PayrollAuditEvent[]

  @@map("organizations")
}

model InvoiceExport {
  id                 String               @id @default(uuid())
  organizationId     String
  requestedByUserId  String
  requestId          String
  requestFingerprint String
  invoiceIds         String
  status             InvoiceExportStatus  @default(QUEUED)
  progress           Int                  @default(0)
  archiveKey         String?
  archiveName        String?
  archiveSize        Int?
  failureCode        String?
  expiresAt          DateTime
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          temporal.updatedAt()

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, requestId])
  @@index([organizationId, requestedByUserId])
  @@index([status, expiresAt])
  @@map("invoice_exports")
}

model User {
  id                      String                     @id @default(uuid())
  organizationId          String
  email                   String
  passwordHash            String
  fullName                String
  firstName               String?
  middleName              String?
  lastName                String?
  phoneNumber             String?
  avatarUrl               String?
  onboardingStatus        OnboardingStatus           @default(LEGACY)
  onboardingStep          String                     @default("welcome")
  createdAt               DateTime                   @default(now())
  updatedAt               temporal.updatedAt()

  organization            Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships             Membership[]
  createdExpenses         Expense[]                  @relation("ExpenseCreator")
  submittedExpenses       Expense[]                  @relation("ExpenseSubmitter")
  reviewedExpenses        Expense[]                  @relation("ExpenseReviewer")
  expenseApprovalEvents   ExpenseApprovalHistory[]   @relation("ExpenseApprovalActor")
  recurringSchedules      RecurringInvoiceSchedule[] @relation("RecurringScheduleCreator")
  recurringScheduleEvents RecurringScheduleEvent[]   @relation("RecurringScheduleActor")
  linkedEmployee          Employee?                  @relation("EmployeeUser")
  createdSalaryStructures SalaryStructure[]          @relation("SalaryCreator")
  employeeAuditEvents     EmployeeAuditEvent[]       @relation("EmployeeAuditActor")
  createdPayrollRuns      PayrollRun[]               @relation("PayrollRunCreator")
  approvedPayrollRuns     PayrollRun[]               @relation("PayrollRunApprover")
  finalizedPayrollRuns    PayrollRun[]               @relation("PayrollRunFinalizer")
  payrollPayments         PayrollPayment[]           @relation("PayrollPaymentRecorder")
  payrollAuditEvents      PayrollAuditEvent[]        @relation("PayrollAuditActor")

  @@unique([organizationId, id])
  @@unique([organizationId, email])

  @@map("users")
}

model Department {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("departments")
}

model Employee {
  id               String               @id @default(uuid())
  organizationId   String
  employeeCode     String
  firstName        String
  lastName         String
  workEmail        String?
  phoneNumber      String?
  notes            String?
  jobTitle         String
  employmentType   EmploymentType
  status           EmploymentStatus     @default(ACTIVE)
  hireDate         DateTime
  terminationDate  DateTime?
  departmentId     String?
  managerId        String?
  linkedUserId     String?
  version          Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        temporal.updatedAt()

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department       Department?          @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)
  manager          Employee?            @relation("EmployeeManager", fields: [organizationId, managerId], references: [organizationId, id], onDelete: Restrict)
  directReports    Employee[]           @relation("EmployeeManager")
  linkedUser       User?                @relation("EmployeeUser", fields: [organizationId, linkedUserId], references: [organizationId, id], onDelete: Restrict)
  salaryStructures SalaryStructure[]
  auditEvents      EmployeeAuditEvent[]
  payrollEntries   PayrollEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, employeeCode])
  @@unique([organizationId, linkedUserId])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, managerId])
  @@map("employees")
}

model SalaryStructure {
  id               String               @id @default(uuid())
  organizationId   String
  employeeId       String
  compensationType CompensationType
  baseAmount       Numeric(12, 2)
  currency         String
  payFrequency     PayFrequency
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  notes            String?
  createdById      String
  version          Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        temporal.updatedAt()

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee         Employee             @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  createdBy        User                 @relation("SalaryCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  components       SalaryComponent[]
  payrollEntries   PayrollEntry[]

  @@unique([organizationId, id])
  @@index([organizationId, employeeId, effectiveFrom], map: "salary_employee_effective_idx")
  @@map("salary_structures")
}

model SalaryComponent {
  id                String              @id @default(uuid())
  organizationId    String
  salaryStructureId String
  name              String
  type              SalaryComponentType
  amount            Numeric(12, 2)
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())

  salaryStructure   SalaryStructure     @relation(fields: [organizationId, salaryStructureId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, salaryStructureId], map: "salary_component_structure_idx")
  @@map("salary_components")
}

model EmployeeAuditEvent {
  id             String              @id @default(uuid())
  organizationId String
  employeeId     String
  actorId        String
  action         EmployeeAuditAction
  details        String?
  createdAt      DateTime            @default(now())

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee            @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  actor          User                @relation("EmployeeAuditActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, employeeId, createdAt], map: "employee_audit_created_idx")
  @@map("employee_audit_events")
}

model PayrollRun {
  id               String               @id @default(uuid())
  organizationId   String
  name             String
  periodStart      DateTime
  periodEnd        DateTime
  paymentDate      DateTime
  status           PayrollRunStatus     @default(DRAFT)
  currency         String
  organizationName String
  totalGross       Numeric(14, 2)       @default(0)
  totalDeductions  Numeric(14, 2)       @default(0)
  totalNet         Numeric(14, 2)       @default(0)
  employeeCount    Int                  @default(0)
  createdById      String
  approvedById     String?
  finalizedById    String?
  rejectionReason  String?
  approvedAt       DateTime?
  finalizedAt      DateTime?
  version          Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        temporal.updatedAt()

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User                 @relation("PayrollRunCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  approvedBy       User?                @relation("PayrollRunApprover", fields: [organizationId, approvedById], references: [organizationId, id], onDelete: Restrict)
  finalizedBy      User?                @relation("PayrollRunFinalizer", fields: [organizationId, finalizedById], references: [organizationId, id], onDelete: Restrict)
  entries          PayrollEntry[]
  auditEvents      PayrollAuditEvent[]

  @@unique([organizationId, id])
  @@index([organizationId, periodStart, periodEnd], map: "payroll_run_period_idx")
  @@index([organizationId, status], map: "payroll_run_status_idx")
  @@map("payroll_runs")
}

model PayrollEntry {
  id                 String                  @id @default(uuid())
  organizationId     String
  payrollRunId       String
  employeeId         String
  salaryStructureId  String
  employeeName       String
  employeeCode       String
  departmentName     String?
  jobTitle           String
  compensationType   CompensationType
  payFrequency       PayFrequency
  baseAmount         Numeric(14, 2)
  grossPay           Numeric(14, 2)
  totalDeductions    Numeric(14, 2)
  netPay             Numeric(14, 2)
  payslipStatus      PayslipStatus           @default(PENDING)
  payslipKey         String?
  payslipFailureCode String?
  version            Int                     @default(1)
  createdAt          DateTime                @default(now())
  updatedAt          temporal.updatedAt()

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRun         PayrollRun              @relation(fields: [organizationId, payrollRunId], references: [organizationId, id], onDelete: Cascade)
  employee           Employee                @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  salaryStructure    SalaryStructure         @relation(fields: [organizationId, salaryStructureId], references: [organizationId, id], onDelete: Restrict)
  components         PayrollEntryComponent[]
  payments           PayrollPayment[]
  auditEvents        PayrollAuditEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, payrollRunId, employeeId])
  @@index([organizationId, employeeId], map: "payroll_entry_employee_idx")
  @@map("payroll_entries")
}

model PayrollEntryComponent {
  id                      String               @id @default(uuid())
  organizationId          String
  payrollEntryId          String
  name                    String
  type                    PayrollComponentType
  amount                  Numeric(14, 2)
  sourceSalaryComponentId String?
  isAdjustment            Boolean              @default(false)
  sortOrder               Int                  @default(0)
  createdAt               DateTime             @default(now())

  payrollEntry            PayrollEntry         @relation(fields: [organizationId, payrollEntryId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, payrollEntryId], map: "payroll_component_entry_idx")
  @@map("payroll_entry_components")
}

model PayrollPayment {
  id             String         @id @default(uuid())
  organizationId String
  payrollEntryId String
  amount         Numeric(14, 2)
  paymentDate    DateTime
  reference      String
  notes          String?
  idempotencyKey String
  recordedById   String
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollEntry   PayrollEntry   @relation(fields: [organizationId, payrollEntryId], references: [organizationId, id], onDelete: Restrict)
  recordedBy     User           @relation("PayrollPaymentRecorder", fields: [organizationId, recordedById], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, payrollEntryId], map: "payroll_payment_entry_idx")
  @@map("payroll_payments")
}

model PayrollAuditEvent {
  id             String             @id @default(uuid())
  organizationId String
  payrollRunId   String
  payrollEntryId String?
  actorId        String
  action         PayrollAuditAction
  details        String?
  createdAt      DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRun     PayrollRun         @relation(fields: [organizationId, payrollRunId], references: [organizationId, id], onDelete: Restrict)
  payrollEntry   PayrollEntry?      @relation(fields: [organizationId, payrollEntryId], references: [organizationId, id], onDelete: Restrict)
  actor          User               @relation("PayrollAuditActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, payrollRunId, createdAt], map: "payroll_audit_run_idx")
  @@map("payroll_audit_events")
}

model Membership {
  id             String       @id @default(uuid())
  role           Role         @default(FINANCE_VIEWER)
  organizationId String
  userId         String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("memberships")
}

model Client {
  id                 String                     @id @default(uuid())
  organizationId     String
  name               String
  email              String
  companyName        String?
  taxId              String?
  createdAt          DateTime                   @default(now())
  updatedAt          temporal.updatedAt()

  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
  recurringSchedules RecurringInvoiceSchedule[]

  @@unique([organizationId, id])
  @@map("clients")
}

model Invoice {
  id                  String                      @id @default(uuid())
  organizationId      String
  clientId            String
  invoiceNumber       String
  version             Int                         @default(1)
  status              InvoiceStatus               @default(DRAFT)
  issueDate           DateTime
  dueDate             DateTime
  subtotal            Numeric(12, 2)
  tax                 Numeric(12, 2)              @default(0.00)
  total               Numeric(12, 2)
  issuedAt            DateTime?
  issuedByUserId      String?
  billingName         String?
  billingEmail        String?
  billingCompanyName  String?
  billingTaxId        String?
  sellerName          String?
  currency            String?
  pdfKey              String?
  pdfUrl              String?
  notes               String?
  createdAt           DateTime                    @default(now())
  updatedAt           temporal.updatedAt()

  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client              Client                      @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  items               InvoiceItem[]
  payments            Payment[]
  recurringOccurrence RecurringInvoiceOccurrence?

  @@unique([organizationId, id])
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, issuedAt])
  @@index([organizationId, issueDate])
  @@index([organizationId, dueDate])
  @@map("invoices")
}

model RecurringInvoiceSchedule {
  id                String                       @id @default(uuid())
  organizationId    String
  clientId          String
  createdById       String
  name              String
  description       String?
  frequency         RecurringFrequency
  interval          Int                          @default(1)
  startDate         DateTime
  endDate           DateTime?
  nextRunAt         DateTime
  lastRunAt         DateTime?
  status            RecurringScheduleStatus      @default(ACTIVE)
  currency          String
  dueDateOffsetDays Int                          @default(14)
  autoIssue         Boolean                      @default(false)
  version           Int                          @default(1)
  createdAt         DateTime                     @default(now())
  updatedAt         temporal.updatedAt()

  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client            Client                       @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  createdBy         User                         @relation("RecurringScheduleCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  items             RecurringInvoiceItem[]
  occurrences       RecurringInvoiceOccurrence[]
  events            RecurringScheduleEvent[]

  @@unique([organizationId, id])
  @@index([status, nextRunAt])
  @@index([organizationId, clientId], map: "recurring_schedule_client_idx")
  @@map("recurring_invoice_schedules")
}

model RecurringScheduleEvent {
  id             String                   @id @default(uuid())
  organizationId String
  scheduleId     String
  actorId        String?
  action         RecurringScheduleAction
  details        String?
  createdAt      DateTime                 @default(now())

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule       RecurringInvoiceSchedule @relation(fields: [organizationId, scheduleId], references: [organizationId, id], onDelete: Cascade)
  actor          User?                    @relation("RecurringScheduleActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, scheduleId, createdAt], map: "recurring_event_schedule_idx")
  @@map("recurring_schedule_events")
}

model RecurringInvoiceItem {
  id             String                   @id @default(uuid())
  organizationId String
  scheduleId     String
  description    String
  quantity       Int                      @default(1)
  unitPrice      Numeric(12, 2)
  amount         Numeric(12, 2)
  position       Int                      @default(0)

  schedule       RecurringInvoiceSchedule @relation(fields: [organizationId, scheduleId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, scheduleId], map: "recurring_item_schedule_idx")
  @@map("recurring_invoice_items")
}

model RecurringInvoiceOccurrence {
  id             String                    @id @default(uuid())
  organizationId String
  scheduleId     String
  scheduledFor   DateTime
  status         RecurringOccurrenceStatus @default(PENDING)
  invoiceId      String?                   @unique
  failureCode    String?
  attempts       Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule       RecurringInvoiceSchedule  @relation(fields: [organizationId, scheduleId], references: [organizationId, id], onDelete: Cascade)
  invoice        Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, scheduleId, scheduledFor], map: "recurring_occurrence_slot_key")
  @@index([organizationId, status], map: "recurring_occurrence_status_idx")
  @@map("recurring_invoice_occurrences")
}

model InvoiceItem {
  id             String         @id @default(uuid())
  organizationId String
  invoiceId      String
  description    String
  quantity       Int            @default(1)
  position       Int            @default(0)
  unitPrice      Numeric(12, 2)
  amount         Numeric(12, 2)

  invoice        Invoice        @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, invoiceId])
  @@map("invoice_items")
}

model Payment {
  id               String         @id @default(uuid())
  organizationId   String
  invoiceId        String
  amount           Numeric(12, 2)
  paymentDate      DateTime
  method           PaymentMethod
  reference        String?
  notes            String?
  recordedByUserId String
  createdAt        DateTime       @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice          Invoice        @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, invoiceId])
  @@index([organizationId, paymentDate])
  @@map("payments")
}

model Expense {
  id              String                   @id @default(uuid())
  organizationId  String
  title           String
  description     String?
  amount          Numeric(12, 2)
  category        ExpenseCategory          @default(OTHER)
  vendor          String?
  notes           String?
  receiptUrl      String?
  receiptKey      String?
  receiptName     String?
  receiptMime     String?
  receiptSize     Int?
  date            DateTime
  createdByUserId String?
  approvalStatus  ExpenseApprovalStatus    @default(APPROVED)
  submittedById   String?
  submittedAt     DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  version         Int                      @default(1)
  createdAt       DateTime                 @default(now())
  updatedAt       temporal.updatedAt()

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?                    @relation("ExpenseCreator", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  submittedBy     User?                    @relation("ExpenseSubmitter", fields: [organizationId, submittedById], references: [organizationId, id], onDelete: Restrict)
  reviewedBy      User?                    @relation("ExpenseReviewer", fields: [organizationId, reviewedById], references: [organizationId, id], onDelete: Restrict)
  approvalHistory ExpenseApprovalHistory[]

  @@unique([organizationId, id])
  @@index([organizationId, date])
  @@index([organizationId, approvalStatus, submittedAt])
  @@index([organizationId, submittedById])
  @@map("expenses")
}

model ExpenseApprovalHistory {
  id              String                @id @default(uuid())
  organizationId  String
  expenseId       String
  actorId         String
  action          ExpenseApprovalAction
  previousStatus  ExpenseApprovalStatus
  newStatus       ExpenseApprovalStatus
  rejectionReason String?
  createdAt       DateTime              @default(now())

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expense         Expense               @relation(fields: [organizationId, expenseId], references: [organizationId, id], onDelete: Cascade)
  actor           User                  @relation("ExpenseApprovalActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, expenseId, createdAt], map: "expense_history_expense_created_idx")
  @@map("expense_approval_history")
}

model Retainer {
  id             String         @id @default(uuid())
  organizationId String
  clientName     String
  monthlyAmount  Numeric(12, 2)
  billingDay     Int            @default(1)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("retainers")
}
