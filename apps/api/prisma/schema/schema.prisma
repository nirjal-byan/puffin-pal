// use prisma-8
enum Role {
  OWNER
  ADMIN
  PROJECT_MANAGER
  FINANCE_VIEWER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum OnboardingStatus {
  LEGACY
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  CHEQUE
  OTHER
}

enum ExpenseCategory {
  SOFTWARE
  HARDWARE
  TRAVEL
  MARKETING
  OTHER
}

enum ExpenseApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum ExpenseApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  REOPENED
  RESUBMITTED
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecurringOccurrenceStatus {
  PENDING
  PROCESSING
  GENERATED
  FAILED
}

enum RecurringScheduleAction {
  CREATED
  UPDATED
  PAUSED
  RESUMED
  CANCELLED
  OCCURRENCE_GENERATED
  AUTO_ISSUED
  GENERATION_FAILED
  RETRIED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

enum CompensationType {
  FIXED_SALARY
  HOURLY
}

enum PayFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum StatutoryComponentClass {
  TAXABLE_EARNING
  NON_TAXABLE_EARNING
  PRE_TAX_DEDUCTION
  POST_TAX_DEDUCTION
}

enum StatutoryRuleStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum StatutoryRuleKind {
  FLAT_WITHHOLDING
  EMPLOYEE_CONTRIBUTION
  EMPLOYER_CONTRIBUTION
}

enum StatutoryCalculationType {
  RATE
  FIXED_AMOUNT
}

enum StatutoryCalculationBase {
  TAXABLE_EARNINGS
  GROSS_EARNINGS
}

enum EmployeeAuditAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  TERMINATED
  SALARY_CREATED
  SALARY_REVISED
  SALARY_SCHEDULED
}

enum PayrollRunStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  FINALIZED
}

enum PayrollComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum PayslipStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayrollAuditAction {
  CREATED
  CALCULATED
  ADJUSTED
  SUBMITTED
  APPROVED
  REJECTED
  FINALIZED
  PAYSLIP_GENERATED
  PAYSLIP_FAILED
  PAYMENT_RECORDED
}

enum PayrollScheduleFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
}

enum PayrollScheduleStatus {
  ACTIVE
  PAUSED
}

enum PayrollAutomationStatus {
  PENDING
  PROCESSING
  GENERATED
  FAILED
  CONFLICT
  SKIPPED
}

enum PayrollAutomationSource {
  SCHEDULED
  MANUAL
}

enum PayrollNotificationType {
  DRAFT_READY
  APPROVAL_PENDING
  AUTOMATION_FAILED
  PAYSLIPS_READY
}

enum PayrollScheduleAction {
  CREATED
  UPDATED
  PAUSED
  RESUMED
}

enum CashFlowForecastAuditAction {
  CONFIGURATION_UPDATED
}

enum BankTransactionDirection {
  CREDIT
  DEBIT
}

enum BankImportStatus {
  IMPORTED
  PARTIALLY_IMPORTED
  FAILED
}

enum ReconciliationTargetType {
  INVOICE_PAYMENT
  PAYROLL_PAYMENT
}

enum PaymentBatchStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentBatchItemStatus {
  PENDING
  ATTEMPTED
  PAID
  FAILED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum AttendanceSource {
  MANUAL
  SELF_SERVICE
}

enum LeaveRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveDayPortion {
  FULL_DAY
  HALF_DAY
}

enum LeaveLedgerKind {
  ALLOCATION
  ACCRUAL
  CARRY_FORWARD
  EXPIRATION
  DEDUCTION
  RESTORATION
  ADJUSTMENT
}

enum LeaveAccrualFrequency {
  ANNUAL
  MONTHLY
  SERVICE_MONTHLY
}

enum LeaveCarryForwardMode {
  NONE
  FULL
  CAPPED
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OvertimeRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

model Organization {
  id                           String                         @id @default(uuid())
  name                         String
  slug                         String                         @unique
  website                      String?
  employeeCount                String?
  logoUrl                      String?
  currency                     String                         @default("USD")
  timezone                     String                         @default("UTC")
  unpaidLeaveDeductionsEnabled Boolean                        @default(false)
  createdAt                    DateTime                       @default(now())
  updatedAt                    temporal.updatedAt()

  users                        User[]
  memberships                  Membership[]
  clients                      Client[]
  invoices                     Invoice[]
  invoiceExports               InvoiceExport[]
  payments                     Payment[]
  expenses                     Expense[]
  expenseApprovalHistory       ExpenseApprovalHistory[]
  retainers                    Retainer[]
  recurringSchedules           RecurringInvoiceSchedule[]
  recurringOccurrences         RecurringInvoiceOccurrence[]
  recurringScheduleEvents      RecurringScheduleEvent[]
  departments                  Department[]
  employees                    Employee[]
  salaryStructures             SalaryStructure[]
  employeeAuditEvents          EmployeeAuditEvent[]
  payrollRuns                  PayrollRun[]
  payrollEntries               PayrollEntry[]
  payrollPayments              PayrollPayment[]
  payrollAuditEvents           PayrollAuditEvent[]
  payrollSchedule              PayrollSchedule?
  payrollOccurrences           PayrollScheduleOccurrence[]
  payrollNotifications         PayrollNotification[]
  payrollScheduleEvents        PayrollScheduleEvent[]
  workSchedules                WorkSchedule[]
  holidays                     Holiday[]
  attendanceRecords            AttendanceRecord[]
  leaveTypes                   LeaveType[]
  leaveRequests                LeaveRequest[]
  leaveLedgerEntries           LeaveLedgerEntry[]
  leaveAccrualPolicies         LeaveAccrualPolicy[]
  attendanceCorrections        AttendanceCorrectionRequest[]
  overtimeRequests             OvertimeRequest[]
  workforceAuditEvents         WorkforceAuditEvent[]
  cashFlowConfiguration        CashFlowForecastConfiguration?
  cashFlowAuditEvents          CashFlowForecastAuditEvent[]
  taxJurisdictions             PayrollTaxJurisdiction[]
  statutoryRuleSets            PayrollStatutoryRuleSet[]
  statutoryApplications        PayrollStatutoryApplication[]
  statutoryAuditEvents         PayrollStatutoryAuditEvent[]
  bankAccounts                 BankAccount[]
  bankImports                  BankTransactionImport[]
  bankTransactions             BankTransaction[]
  bankReconciliations          BankReconciliation[]
  bankingAuditEvents           BankingAuditEvent[]
  payrollPaymentBatches        PayrollPaymentBatch[]
  payrollPaymentBatchItems     PayrollPaymentBatchItem[]

  @@map("organizations")
}

model CashFlowForecastConfiguration {
  organizationId                  String               @id
  openingBalance                  Numeric(14, 2)?
  openingBalanceDate              DateTime?
  defaultHorizonDays              Int                  @default(30)
  expectedInvoiceCollectionDelay  Int                  @default(7)
  conservativeDelayAdjustmentDays Int                  @default(14)
  optimisticDelayAdjustmentDays   Int                  @default(0)
  includeRecurringInvoices        Boolean              @default(true)
  includeApprovedPayroll          Boolean              @default(true)
  includeSalaryEstimates          Boolean              @default(false)
  includeApprovedExpenses         Boolean              @default(false)
  version                         Int                  @default(1)
  updatedById                     String
  createdAt                       DateTime             @default(now())
  updatedAt                       temporal.updatedAt()

  organization                    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "cash_flow_config_org_fkey")
  updatedBy                       User                 @relation("CashFlowConfigurationUpdater", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: Restrict, map: "cash_flow_config_updater_fkey")

  @@index([organizationId, updatedById], map: "cash_flow_config_updater_idx")
  @@map("cash_flow_forecast_configurations")
}

model CashFlowForecastAuditEvent {
  id             String                      @id @default(uuid())
  organizationId String
  actorId        String
  action         CashFlowForecastAuditAction
  details        String
  createdAt      DateTime                    @default(now())

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "cash_flow_audit_org_fkey")
  actor          User                        @relation("CashFlowForecastAuditActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict, map: "cash_flow_audit_actor_fkey")

  @@index([organizationId, createdAt], map: "cash_flow_audit_created_idx")
  @@index([organizationId, actorId], map: "cash_flow_audit_actor_idx")
  @@map("cash_flow_forecast_audit_events")
}

model InvoiceExport {
  id                 String               @id @default(uuid())
  organizationId     String
  requestedByUserId  String
  requestId          String
  requestFingerprint String
  invoiceIds         String
  status             InvoiceExportStatus  @default(QUEUED)
  progress           Int                  @default(0)
  archiveKey         String?
  archiveName        String?
  archiveSize        Int?
  failureCode        String?
  expiresAt          DateTime
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          temporal.updatedAt()

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, requestId])
  @@index([organizationId, requestedByUserId])
  @@index([status, expiresAt])
  @@map("invoice_exports")
}

model User {
  id                             String                          @id @default(uuid())
  organizationId                 String
  email                          String
  passwordHash                   String
  fullName                       String
  firstName                      String?
  middleName                     String?
  lastName                       String?
  phoneNumber                    String?
  avatarUrl                      String?
  onboardingStatus               OnboardingStatus                @default(LEGACY)
  onboardingStep                 String                          @default("welcome")
  createdAt                      DateTime                        @default(now())
  updatedAt                      temporal.updatedAt()

  organization                   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships                    Membership[]
  createdExpenses                Expense[]                       @relation("ExpenseCreator")
  submittedExpenses              Expense[]                       @relation("ExpenseSubmitter")
  reviewedExpenses               Expense[]                       @relation("ExpenseReviewer")
  expenseApprovalEvents          ExpenseApprovalHistory[]        @relation("ExpenseApprovalActor")
  recurringSchedules             RecurringInvoiceSchedule[]      @relation("RecurringScheduleCreator")
  recurringScheduleEvents        RecurringScheduleEvent[]        @relation("RecurringScheduleActor")
  linkedEmployee                 Employee?                       @relation("EmployeeUser")
  createdSalaryStructures        SalaryStructure[]               @relation("SalaryCreator")
  employeeAuditEvents            EmployeeAuditEvent[]            @relation("EmployeeAuditActor")
  createdPayrollRuns             PayrollRun[]                    @relation("PayrollRunCreator")
  approvedPayrollRuns            PayrollRun[]                    @relation("PayrollRunApprover")
  finalizedPayrollRuns           PayrollRun[]                    @relation("PayrollRunFinalizer")
  payrollPayments                PayrollPayment[]                @relation("PayrollPaymentRecorder")
  payrollAuditEvents             PayrollAuditEvent[]             @relation("PayrollAuditActor")
  createdPayrollSchedules        PayrollSchedule[]               @relation("PayrollScheduleCreator")
  payrollNotifications           PayrollNotification[]           @relation("PayrollNotificationRecipient")
  payrollScheduleEvents          PayrollScheduleEvent[]          @relation("PayrollScheduleEventActor")
  createdAttendance              AttendanceRecord[]              @relation("AttendanceCreator")
  updatedAttendance              AttendanceRecord[]              @relation("AttendanceUpdater")
  requestedAttendanceCorrections AttendanceCorrectionRequest[]   @relation("AttendanceCorrectionRequester")
  reviewedAttendanceCorrections  AttendanceCorrectionRequest[]   @relation("AttendanceCorrectionReviewer")
  reviewedLeaveRequests          LeaveRequest[]                  @relation("LeaveReviewer")
  reviewedOvertime               OvertimeRequest[]               @relation("OvertimeReviewer")
  workforceAuditEvents           WorkforceAuditEvent[]           @relation("WorkforceAuditActor")
  updatedCashFlowConfig          CashFlowForecastConfiguration[] @relation("CashFlowConfigurationUpdater")
  cashFlowAuditEvents            CashFlowForecastAuditEvent[]    @relation("CashFlowForecastAuditActor")
  createdStatutoryRules          PayrollStatutoryRuleSet[]       @relation("StatutoryRuleCreator")
  activatedStatutoryRules        PayrollStatutoryRuleSet[]       @relation("StatutoryRuleActivator")
  appliedStatutoryCalculations   PayrollStatutoryApplication[]   @relation("StatutoryApplicationActor")
  statutoryAuditEvents           PayrollStatutoryAuditEvent[]    @relation("StatutoryAuditActor")
  createdBankAccounts            BankAccount[]                   @relation("BankAccountCreator")
  uploadedBankImports            BankTransactionImport[]         @relation("BankImportUploader")
  bankReconciliations            BankReconciliation[]            @relation("BankReconciliationActor")
  reversedBankReconciliations    BankReconciliation[]            @relation("BankReconciliationReverser")
  bankingAuditEvents             BankingAuditEvent[]             @relation("BankingAuditActor")
  createdPaymentBatches          PayrollPaymentBatch[]           @relation("PaymentBatchCreator")

  @@unique([organizationId, id])
  @@unique([organizationId, email])

  @@map("users")
}

model Department {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("departments")
}

model Employee {
  id                    String                        @id @default(uuid())
  organizationId        String
  employeeCode          String
  firstName             String
  lastName              String
  workEmail             String?
  phoneNumber           String?
  notes                 String?
  jobTitle              String
  employmentType        EmploymentType
  status                EmploymentStatus              @default(ACTIVE)
  hireDate              DateTime
  terminationDate       DateTime?
  departmentId          String?
  managerId             String?
  linkedUserId          String?
  version               Int                           @default(1)
  createdAt             DateTime                      @default(now())
  updatedAt             temporal.updatedAt()

  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department            Department?                   @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)
  manager               Employee?                     @relation("EmployeeManager", fields: [organizationId, managerId], references: [organizationId, id], onDelete: Restrict)
  directReports         Employee[]                    @relation("EmployeeManager")
  linkedUser            User?                         @relation("EmployeeUser", fields: [organizationId, linkedUserId], references: [organizationId, id], onDelete: Restrict)
  salaryStructures      SalaryStructure[]
  auditEvents           EmployeeAuditEvent[]
  payrollEntries        PayrollEntry[]
  workSchedules         WorkSchedule[]
  attendance            AttendanceRecord[]
  leaveRequests         LeaveRequest[]
  leaveLedger           LeaveLedgerEntry[]
  attendanceCorrections AttendanceCorrectionRequest[]
  overtimeRequests      OvertimeRequest[]
  workforceEvents       WorkforceAuditEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, employeeCode])
  @@unique([organizationId, linkedUserId])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, managerId])
  @@map("employees")
}

model SalaryStructure {
  id               String               @id @default(uuid())
  organizationId   String
  employeeId       String
  compensationType CompensationType
  baseAmount       Numeric(12, 2)
  currency         String
  payFrequency     PayFrequency
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  notes            String?
  createdById      String
  version          Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        temporal.updatedAt()

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee         Employee             @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  createdBy        User                 @relation("SalaryCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  components       SalaryComponent[]
  payrollEntries   PayrollEntry[]

  @@unique([organizationId, id])
  @@index([organizationId, employeeId, effectiveFrom], map: "salary_employee_effective_idx")
  @@map("salary_structures")
}

model SalaryComponent {
  id                String                   @id @default(uuid())
  organizationId    String
  salaryStructureId String
  name              String
  type              SalaryComponentType
  amount            Numeric(12, 2)
  sortOrder         Int                      @default(0)
  statutoryClass    StatutoryComponentClass?
  createdAt         DateTime                 @default(now())

  salaryStructure   SalaryStructure          @relation(fields: [organizationId, salaryStructureId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, salaryStructureId], map: "salary_component_structure_idx")
  @@map("salary_components")
}

model PayrollTaxJurisdiction {
  id                   String                    @id @default(uuid())
  organizationId       String
  countryCode          String
  subdivisionCode      String?
  currency             String
  taxYearStartMonth    Int                       @default(1)
  taxYearStartDay      Int                       @default(1)
  mandatoryCalculation Boolean                   @default(false)
  isActive             Boolean                   @default(true)
  version              Int                       @default(1)
  createdAt            DateTime                  @default(now())
  updatedAt            temporal.updatedAt()

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "tax_jurisdiction_org_fkey")
  ruleSets             PayrollStatutoryRuleSet[]

  @@unique([organizationId, id])
  @@unique([organizationId, countryCode, subdivisionCode], map: "tax_jurisdiction_region_key")
  @@index([organizationId, isActive], map: "tax_jurisdiction_active_idx")
  @@map("payroll_tax_jurisdictions")
}

model PayrollStatutoryRuleSet {
  id             String                        @id @default(uuid())
  organizationId String
  jurisdictionId String
  name           String
  version        Int
  status         StatutoryRuleStatus           @default(DRAFT)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  periodsPerYear Int?
  createdById    String
  activatedById  String?
  activatedAt    DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "stat_rule_org_fkey")
  jurisdiction   PayrollTaxJurisdiction        @relation(fields: [organizationId, jurisdictionId], references: [organizationId, id], onDelete: Restrict, map: "stat_rule_jurisdiction_fkey")
  createdBy      User                          @relation("StatutoryRuleCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict, map: "stat_rule_creator_fkey")
  activatedBy    User?                         @relation("StatutoryRuleActivator", fields: [organizationId, activatedById], references: [organizationId, id], onDelete: Restrict, map: "stat_rule_activator_fkey")
  brackets       PayrollTaxBracket[]
  rules          PayrollStatutoryRule[]
  applications   PayrollStatutoryApplication[]

  @@unique([organizationId, id])
  @@unique([organizationId, jurisdictionId, name, version], map: "stat_rule_version_key")
  @@index([organizationId, jurisdictionId, status, effectiveFrom], map: "stat_rule_effective_idx")
  @@map("payroll_statutory_rule_sets")
}

model PayrollTaxBracket {
  id             String                  @id @default(uuid())
  organizationId String
  ruleSetId      String
  lowerBound     Numeric(14, 2)
  upperBound     Numeric(14, 2)?
  rate           Numeric(9, 6)
  sortOrder      Int
  createdAt      DateTime                @default(now())

  ruleSet        PayrollStatutoryRuleSet @relation(fields: [organizationId, ruleSetId], references: [organizationId, id], onDelete: Cascade, map: "tax_bracket_rule_fkey")

  @@unique([organizationId, ruleSetId, sortOrder], map: "tax_bracket_order_key")
  @@index([organizationId, ruleSetId], map: "tax_bracket_rule_idx")
  @@map("payroll_tax_brackets")
}

model PayrollStatutoryRule {
  id              String                   @id @default(uuid())
  organizationId  String
  ruleSetId       String
  name            String
  kind            StatutoryRuleKind
  calculationType StatutoryCalculationType
  calculationBase StatutoryCalculationBase
  rate            Numeric(9, 6)?
  fixedAmount     Numeric(14, 2)?
  minimumBase     Numeric(14, 2)?
  maximumBase     Numeric(14, 2)?
  contributionCap Numeric(14, 2)?
  sortOrder       Int                      @default(0)
  createdAt       DateTime                 @default(now())

  ruleSet         PayrollStatutoryRuleSet  @relation(fields: [organizationId, ruleSetId], references: [organizationId, id], onDelete: Cascade, map: "stat_item_rule_set_fkey")

  @@index([organizationId, ruleSetId], map: "stat_item_rule_set_idx")
  @@map("payroll_statutory_rules")
}

model EmployeeAuditEvent {
  id             String              @id @default(uuid())
  organizationId String
  employeeId     String
  actorId        String
  action         EmployeeAuditAction
  details        String?
  createdAt      DateTime            @default(now())

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee            @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  actor          User                @relation("EmployeeAuditActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, employeeId, createdAt], map: "employee_audit_created_idx")
  @@map("employee_audit_events")
}

model PayrollRun {
  id                 String                     @id @default(uuid())
  organizationId     String
  name               String
  periodStart        DateTime
  periodEnd          DateTime
  paymentDate        DateTime
  status             PayrollRunStatus           @default(DRAFT)
  currency           String
  organizationName   String
  totalGross         Numeric(14, 2)             @default(0)
  totalDeductions    Numeric(14, 2)             @default(0)
  totalNet           Numeric(14, 2)             @default(0)
  employeeCount      Int                        @default(0)
  createdById        String
  approvedById       String?
  finalizedById      String?
  rejectionReason    String?
  approvedAt         DateTime?
  finalizedAt        DateTime?
  version            Int                        @default(1)
  payrollScheduleId  String?
  createdAt          DateTime                   @default(now())
  updatedAt          temporal.updatedAt()

  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          User                       @relation("PayrollRunCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  approvedBy         User?                      @relation("PayrollRunApprover", fields: [organizationId, approvedById], references: [organizationId, id], onDelete: Restrict)
  finalizedBy        User?                      @relation("PayrollRunFinalizer", fields: [organizationId, finalizedById], references: [organizationId, id], onDelete: Restrict)
  entries            PayrollEntry[]
  auditEvents        PayrollAuditEvent[]
  payrollSchedule    PayrollSchedule?           @relation(fields: [organizationId, payrollScheduleId], references: [organizationId, id], onDelete: Restrict)
  scheduleOccurrence PayrollScheduleOccurrence?
  paymentBatches     PayrollPaymentBatch[]

  @@unique([organizationId, id])
  @@index([organizationId, periodStart, periodEnd], map: "payroll_run_period_idx")
  @@index([organizationId, status], map: "payroll_run_status_idx")
  @@unique([organizationId, payrollScheduleId, periodStart], map: "payroll_run_schedule_period_key")
  @@map("payroll_runs")
}

model PayrollSchedule {
  id                String                      @id @default(uuid())
  organizationId    String                      @unique
  createdById       String
  name              String
  frequency         PayrollScheduleFrequency
  timezone          String
  startDate         DateTime
  nextPeriodStart   DateTime
  periodAnchorDay   Int
  generationTime    String                      @default("09:00")
  paymentOffsetDays Int?
  status            PayrollScheduleStatus       @default(ACTIVE)
  lastSuccessfulAt  DateTime?
  nextRunAt         DateTime
  version           Int                         @default(1)
  createdAt         DateTime                    @default(now())
  updatedAt         temporal.updatedAt()

  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User                        @relation("PayrollScheduleCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  payrollRuns       PayrollRun[]
  occurrences       PayrollScheduleOccurrence[]
  events            PayrollScheduleEvent[]

  @@unique([organizationId, id])
  @@index([status, nextRunAt], map: "payroll_schedule_due_idx")
  @@map("payroll_schedules")
}

model PayrollScheduleOccurrence {
  id             String                  @id @default(uuid())
  organizationId String
  scheduleId     String
  payrollRunId   String?
  periodStart    DateTime
  periodEnd      DateTime
  scheduledFor   DateTime
  source         PayrollAutomationSource
  status         PayrollAutomationStatus @default(PENDING)
  attempts       Int                     @default(0)
  failureCode    String?
  failureMessage String?
  createdAt      DateTime                @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule       PayrollSchedule         @relation(fields: [organizationId, scheduleId], references: [organizationId, id], onDelete: Cascade)
