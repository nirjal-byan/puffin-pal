// use prisma-8
enum Role {
  OWNER
  ADMIN
  PROJECT_MANAGER
  FINANCE_VIEWER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum OnboardingStatus {
  LEGACY
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  CHEQUE
  OTHER
}

enum ExpenseCategory {
  SOFTWARE
  HARDWARE
  TRAVEL
  MARKETING
  OTHER
}

model Organization {
  id            String               @id @default(uuid())
  name          String
  slug          String               @unique
  website       String?
  employeeCount String?
  logoUrl       String?
  currency      String               @default("USD")
  createdAt     DateTime             @default(now())
  updatedAt     temporal.updatedAt()

  users         User[]
  memberships   Membership[]
  clients       Client[]
  invoices      Invoice[]
  payments      Payment[]
  expenses      Expense[]
  retainers     Retainer[]

  @@map("organizations")
}

model User {
  id               String               @id @default(uuid())
  organizationId   String
  email            String
  passwordHash     String
  fullName         String
  firstName        String?
  middleName       String?
  lastName         String?
  phoneNumber      String?
  avatarUrl        String?
  onboardingStatus OnboardingStatus     @default(LEGACY)
  onboardingStep   String               @default("welcome")
  createdAt        DateTime             @default(now())
  updatedAt        temporal.updatedAt()

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships      Membership[]

  @@unique([organizationId, id])
  @@unique([organizationId, email])

  @@map("users")
}

model Membership {
  id             String       @id @default(uuid())
  role           Role         @default(FINANCE_VIEWER)
  organizationId String
  userId         String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("memberships")
}

model Client {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  email          String
  companyName    String?
  taxId          String?
  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]

  @@unique([organizationId, id])
  @@map("clients")
}

model Invoice {
  id                 String               @id @default(uuid())
  organizationId     String
  clientId           String
  invoiceNumber      String
  version            Int                  @default(1)
  status             InvoiceStatus        @default(DRAFT)
  issueDate          DateTime
  dueDate            DateTime
  subtotal           Numeric(12, 2)
  tax                Numeric(12, 2)       @default(0.00)
  total              Numeric(12, 2)
  issuedAt           DateTime?
  issuedByUserId     String?
  billingName        String?
  billingEmail       String?
  billingCompanyName String?
  billingTaxId       String?
  sellerName         String?
  currency           String?
  pdfUrl             String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          temporal.updatedAt()

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client             Client               @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  items              InvoiceItem[]
  payments           Payment[]

  @@unique([organizationId, id])
  @@unique([organizationId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id             String         @id @default(uuid())
  organizationId String
  invoiceId      String
  description    String
  quantity       Int            @default(1)
  position       Int            @default(0)
  unitPrice      Numeric(12, 2)
  amount         Numeric(12, 2)

  invoice        Invoice        @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, invoiceId])
  @@map("invoice_items")
}

model Payment {
  id               String         @id @default(uuid())
  organizationId   String
  invoiceId        String
  amount           Numeric(12, 2)
  paymentDate      DateTime
  method           PaymentMethod
  reference        String?
  notes            String?
  recordedByUserId String
  createdAt        DateTime       @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice          Invoice        @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, invoiceId])
  @@map("payments")
}

model Expense {
  id             String          @id @default(uuid())
  organizationId String
  title          String
  description    String?
  amount         Numeric(12, 2)
  category       ExpenseCategory @default(OTHER)
  vendor         String?
  notes          String?
  receiptUrl     String?
  receiptKey     String?
  receiptName    String?
  receiptMime    String?
  receiptSize    Int?
  date           DateTime
  createdAt      DateTime        @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@map("expenses")
}

model Retainer {
  id             String         @id @default(uuid())
  organizationId String
  clientName     String
  monthlyAmount  Numeric(12, 2)
  billingDay     Int            @default(1)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("retainers")
}
