# Local development template. Copy to apps/api/.env; never commit the populated file.
DATABASE_URL=postgresql://puffinpal_admin:puffinpal_password@localhost:5433/puffinpal_dev
PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0

# Required only for make database.seed (at least 12 characters):
# SEED_OWNER_PASSWORD=

# Required: set to a unique random secret of at least 32 bytes.
JWT_SECRET=

# Required Redis-backed authentication rate limiting. Keep Redis private in production.
REDIS_URL=redis://:puffinpal_redis_password@127.0.0.1:6379
REDIS_RATE_LIMIT_PREFIX=puffinpal:auth-rate-limit
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_RECONNECT_MAX_RETRIES=3

# BullMQ uses the same private Redis service with a separate key namespace.
# Override BULLMQ_REDIS_URL when workers use a different private Redis endpoint.
BULLMQ_REDIS_URL=redis://:puffinpal_redis_password@127.0.0.1:6379
BULLMQ_PREFIX=puffinpal:jobs
BULLMQ_CONNECT_TIMEOUT_MS=5000
BULLMQ_RECONNECT_MAX_RETRIES=5
PAYROLL_WORKER_CONCURRENCY=2
INVOICE_EXPORT_WORKER_CONCURRENCY=2
RECURRING_INVOICE_WORKER_CONCURRENCY=2
INVOICE_EXPORT_RETENTION_HOURS=24

# Private SeaweedFS S3 object storage (receipts, invoice PDFs, exports, and payslips)
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=puffinpal-receipts
S3_ACCESS_KEY_ID=puffinpal_local
S3_SECRET_ACCESS_KEY=puffinpal_local_secret
