DATABASE_URL=postgresql://puffinpal_admin:puffinpal_password@localhost:5433/puffinpal_dev
PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000

# Required only for make database.seed (at least 12 characters):
# SEED_OWNER_PASSWORD=

# Required: set to a unique random secret of at least 32 bytes.
JWT_SECRET=

# Required Redis-backed authentication rate limiting. Keep Redis private in production.
REDIS_URL=redis://:puffinpal_redis_password@127.0.0.1:6379
REDIS_RATE_LIMIT_PREFIX=puffinpal:auth-rate-limit
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_RECONNECT_MAX_RETRIES=3

# Private SeaweedFS S3 object storage (expense receipts and invoice PDFs)
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=puffinpal-receipts
S3_ACCESS_KEY_ID=puffinpal_local
S3_SECRET_ACCESS_KEY=puffinpal_local_secret
